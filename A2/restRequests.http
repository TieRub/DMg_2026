###Post multiple clients
POST http://127.0.0.1:8080/clients
Content-Type: application/json

[
  {
        "name": "Test user1"
  },
  {
    "name": "Test user2"
  }
]

###
> {%
client.test("Status OK",function() {
  client.assert(response.status === 200,"Fehler")});
%}


