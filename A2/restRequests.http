    {
      "id": 3,
      "name": "Test user4",
      "rides": []
    },
    {
      "id": 1,
      "name": "put to user1",
      "rides": []
    }
]

###
> {%
client.test("Status OK",function() {
  client.assert(response.status === 200,"Fehler")});
%}


